; Corgi Herding — Godot 4.6.3
config_version=5

[application]
config/name="Corgi Herding"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"
config/version="0.1.0"

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1200
window/size/window_height_override=750
window/stretch/mode="canvas_items"
window/handheld/orientation=0

[input_devices]
pointing/emulate_mouse_from_touch=true

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.80, 0.86, 0.78, 1)
lights_and_shadows/directional_shadow/size=2048

[network]
limits/tcp/connect_timeout_seconds=10
